# RECETARIA API - VARIABLES DE ENTORNO (.env.example)
# Copiar a .env para desarrollo local y completar los valores (ver README.md)
# PROHIBIDO versionar el archivo .env real

# Configuración de la Aplicación
NODE_ENV=
PORT=
IMAGE_TAG=

# Credenciales de PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Conexión desde el Host (leída con dotenv)
DATABASE_URL=

# Opcional: base de pruebas. Si se omite, `npm test` usa automáticamente <base de DATABASE_URL>_test
# (la crea y migra sola). Su nombre DEBE terminar en _test; las pruebas nunca tocan DATABASE_URL.
TEST_DATABASE_URL=

# Generado con openssl rand -base64 48
# Seguridad JWT (leída con dotenv)
JWT_SECRET=
# Vigencia del JWT con unidad explícita (s|m|h|d|w|y). Por defecto 1d; MÁXIMO 1d (86400 s, #52):
# un valor mayor (p. ej. 2d, 1w) impide arrancar. Ejemplos válidos: 15m, 1h, 12h, 24h, 1d.
JWT_EXPIRES_IN=

# Proxies de confianza para leer la IP real del cliente (X-Forwarded-For) en el rate limit.
# Vacío o 0 = no confiar (API expuesta directamente). Número EXACTO de saltos (1-10) o lista
# de IPs/CIDR/presets (loopback, linklocal, uniquelocal); preferí la IP exacta del proxy.
# Más saltos que proxies reales (o 1 sin proxy delante) permite falsificar la IP.
# Se rechazan true/false y rangos más amplios que /8 (IPv4) o /16 (IPv6).
TRUST_PROXY=

# 1 = oculta el aviso de actualización de Prisma en la consola (valor sugerido en el README)
PRISMA_HIDE_UPDATE_MESSAGE=