# ==============================================================================
# RECETARIA API - VARIABLES DE ENTORNO (.env.example)
# Copiar a .env para desarrollo local: cp .env.example .env
# PROHIBIDO versionar el archivo .env real con secretos productivos
# ==============================================================================

# Configuración de la Aplicación
NODE_ENV=development
PORT=3000
IMAGE_TAG=1.0.0

# Credenciales de PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=recetaria
POSTGRES_PORT=5432

# Conexión desde el Host (para npx prisma migrate / studio)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/recetaria?schema=public"

# Seguridad JWT
JWT_SECRET="cambiar_por_secreto_criptografico_de_al_menos_64_caracteres"
JWT_EXPIRES_IN="1d"
