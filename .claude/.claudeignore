# .claudeignore - Exclusiones de contexto para Claude Code
# Sintaxis idéntica a .gitignore para optimización de tokens y prevención de fugas

# Dependencias y artefactos compilados
node_modules/
dist/
build/
coverage/
.nyc_output/
*.tsbuildinfo

# Control de versiones y cachés
.git/
.cache/
.turbo/
.npm/

# Variables de entorno y secretos (CRÍTICO)
.env
.env.*
!.env.example

# Logs y volcados
logs/
*.log
npm-debug.log*
yarn-debug.log*

# Archivos locales de desarrollo y ramas de agentes
CLAUDE.local.md
settings.local.json
worktrees/
.claude/worktrees/
