{
  "name": "recetaria",
  "version": "1.0.0",
  "description": "Una API RESTful robusta diseñada para centralizar recetas, cruzando contenido generado por usuarios con validación estricta de profesionales clínicos y gastronómicos.",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:config": "docker compose config -q",
    "docker:db": "docker compose up -d postgres",
    "docker:dev": "docker compose up --build",
    "docker:debug": "docker compose --profile debug up -d",
    "docker:prod": "docker compose -f compose.yaml up --build -d",
    "docker:down": "docker compose down"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgfnicolas/recetaria.git"
  },
  "keywords": [],
  "author": "Facundo Nicolás González",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zgfnicolas/recetaria/issues"
  },
  "homepage": "https://github.com/zgfnicolas/recetaria#readme",
  "dependencies": {
    "@prisma/adapter-pg": "~7.10.1",
    "@prisma/client": "~7.10.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "prisma": "~7.10.1",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true
  }
}
