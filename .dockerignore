# .dockerignore - SKL-DEVOPS-DKR-001
# Exclusión de contexto para optimizar BuildKit, velocidad de compilación y seguridad

# Control de versiones
.git
.gitignore

# Dependencias y artefactos locales (evita colisión de binarios host Windows vs contenedor Linux)
node_modules
dist
build
coverage
src/generated
.nyc_output
*.tsbuildinfo

# Logs y temporales
logs
*.log
npm-debug.log*
tmp
.cache
.turbo

# Variables de entorno y secretos (RF-07 / Antipatrón 3 / Regla NEVER)
.env
.env.*
!.env.example
secrets/
*.pem
*.key

# Archivos de configuración de IA, tests y documentación (no requeridos en imagen de build/runtime)
.agents
.github
scripts
docs
tests
vitest.config.ts
tsconfig.test.json
*.md
LICENSE
database_schema_init.sql
compose*.yaml
docker-compose*.yml
